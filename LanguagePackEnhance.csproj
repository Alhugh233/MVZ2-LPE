<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LanguagePackEnhance</AssemblyName>
    <Product>LanguagePackEnhance</Product>
    <Version>1.2.0</Version>
    <BepInExPluginGuid>com.mvz2.languagepackenhance</BepInExPluginGuid>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>LanguagePackEnhance</RootNamespace>
    <InteropDir Condition="'$(InteropDir)' == ''">$(MSBuildThisFileDirectory)interop</InteropDir>
    <ApiProject Condition="'$(ApiProject)' == ''">$(MSBuildThisFileDirectory)../LanguagePackEnhance.API/LanguagePackEnhance.API.csproj</ApiProject>
    <DshCoreDir Condition="'$(DshCoreDir)' == ''">$(MSBuildThisFileDirectory)libs/dshcore</DshCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DSHCore">
      <HintPath>$(DshCoreDir)/DSHCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ApiProject)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\LanguagePackEnhance.icon.png">
      <LogicalName>LanguagePackEnhance.icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MVZ2">
      <HintPath>$(InteropDir)/MVZ2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MVZ2.View">
      <HintPath>$(InteropDir)/MVZ2.View.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MVZ2.Logic">
      <HintPath>$(InteropDir)/MVZ2.Logic.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(InteropDir)/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NGettext">
      <HintPath>$(InteropDir)/NGettext.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
